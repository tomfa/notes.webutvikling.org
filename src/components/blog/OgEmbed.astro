---
import { LinkPreview } from "astro-embed";

interface Props {
	url: string;
}

const { url } = Astro.props;
---

<div
	class="og-embed w-full overflow-hidden rounded-xl border border-dashed border-current/25"
	data-pagefind-ignore
>
	<LinkPreview id={url} />
</div>

<style>
	.og-embed {
		--link-preview-width: 100%;
		--link-preview-padding-inline: 1rem;
		--link-preview-padding-block: 0.75rem;
		--link-preview-corners: 0;
		--link-preview-description-lines: 2;
	}

	.og-embed :global(.link-preview__title) {
		font-weight: 600;
		text-decoration: none;
	}

	.og-embed :global(.link-preview__domain),
	.og-embed :global(.link-preview__description) {
		opacity: 0.65;
		font-size: 0.75rem;
	}
</style>
