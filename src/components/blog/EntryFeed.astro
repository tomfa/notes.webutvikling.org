---
import { getUniqueTags } from "@/utils";
import type { Entry } from "@/utils/post";
import EntryPreview from "./EntryPreview.astro";
import TagSidebar from "./TagSidebar.astro";

interface Props {
	entries: Entry[];
	withHero?: boolean;
}

const { entries, withHero = false } = Astro.props;

const uniqueTags = getUniqueTags(entries, 2).sort((a, b) => a.localeCompare(b));
---

<section aria-label="Blog post list" class="mt-16">
	<div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8 relative">
		<section aria-label="Blog post list">
			<ul class="space-y-16 text-left">
				{
					entries.map((p) => (
						<li class="flex flex-wrap items-center gap-x-2">
							<EntryPreview post={p} as="h2" withDesc withHero={withHero} />
						</li>
					))
				}
			</ul>
		</section>
		{
			uniqueTags.length > 0 && (
				<aside class="sm:sticky self-start top-8">
					<TagSidebar tags={uniqueTags} showAllLink />
				</aside>
			)
		}
	</div>
</section>
