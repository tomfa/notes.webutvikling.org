---
import type { IElement } from "@/data/shared";
import { getEntryUrl, getFormattedDate, getLinkTypeFromUrl, hasBody } from "@/utils";
import type { Entry } from "@/utils/post";
import NotesIcon from "./NotesIcon.astro";

interface Props extends IElement {
	post: Entry;
	withDesc?: boolean;
	withTags?: boolean;
}

const { post, as: Element = "div", withDesc = true, withTags = true } = Astro.props;
const date = new Date(post.data.pubDate || Date.now());
const datetime = date.toISOString();
const postDate = getFormattedDate(date, { month: "short" });
const notes = hasBody(post);
const url = getEntryUrl(post);
const isLib =
	("type" in post.data && post.data.type === "lib") ||
	(url != null && getLinkTypeFromUrl(url) === "lib");
---

<Element class="flex w-full items-baseline justify-between gap-x-2">
	<span>
		<a href={url} class="cactus-link inline-block" rel="prefetch">
			{post.data.title}
		</a>
		{isLib && <span class="ml-2 text-xs text-gray-400">lib</span>}
	</span>
	{notes && <NotesIcon slug={post.slug} />}
</Element>
<div class="align-start mt-1 flex w-full justify-between flex-col sm:flex-row">
	<div class="shrink-0">
		<time class="mr-3 text-xs text-gray-400" datetime={datetime}>{postDate}</time>
	</div>
	<div class="sm:text-right">
		{
			post.data.tags.map((tag, i) => (
				<>
					<a
						href={`/tags/${tag}`}
						aria-label={`View all posts with the tag: ${tag}`}
						class="link mr-2 items-center justify-center rounded-lg text-xs text-accent dark:opacity-30 dark:hover:opacity-100"
					>
						{tag}
					</a>{" "}
				</>
			))
		}
	</div>
</div>

{withDesc && <p class="mt-2 w-full">{post.data.description}</p>}
