---
import "../styles/search.css";
---

<script>
	(() => {
		const onIdle = window.requestIdleCallback || ((cb: IdleRequestCallback) => setTimeout(cb, 1));
		onIdle(async () => {
			const { getInstanceManager } = await import("@pagefind/component-ui");

			// Pagefind's components register themselves with a module-level instance and
			// never deregister. Client-side navigation replaces them, so the instance has
			// to go as well, or the trigger keeps opening the modal belonging to the page
			// we navigated away from.
			document.addEventListener("astro:before-swap", () => {
				const manager = getInstanceManager();
				for (const name of manager.getInstanceNames()) {
					manager.removeInstance(name);
				}
			});
		});
	})();
</script>

<pagefind-modal-trigger compact hide-shortcut></pagefind-modal-trigger>
<pagefind-modal reset-on-close></pagefind-modal>
