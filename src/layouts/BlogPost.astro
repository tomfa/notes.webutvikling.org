---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Base from "./Base.astro";
import Hero from "@/components/blog/Hero";
import TagSidebar from "@/components/blog/TagSidebar";
import { getOgDescription, getOgImageSrc, resolveOgImage } from "@/utils";
import { getMarkdownPath } from "../utils/llms";

interface Props {
	post: CollectionEntry<"post"> | CollectionEntry<"link">;
	indexable?: boolean;
}

const { post, indexable = true } = Astro.props;
const { headings } = await render(post);
const minDepth = headings.reduce((min, { depth }) => Math.min(min, depth), Infinity);

const ogImageSrc = getOgImageSrc(post);
let image: string | undefined;
try {
	image = ogImageSrc ? await resolveOgImage(ogImageSrc) : undefined;
} catch {
	image = undefined;
}
const imageAlt = "imageAlt" in post.data ? post.data.imageAlt : undefined;
const tags = post.data.tags;
---

<Base
	meta={{
		title: post.data.title,
		description: getOgDescription(post),
		image,
		imageAlt,
		ogType: "article",
		publishDate: post.data.pubDate,
		markdownUrl: getMarkdownPath(post),
	}}
>
	<div class="sm:grid sm:grid-cols-[3fr_1fr] sm:items-start sm:gap-x-10">
		<article class="break-words" data-pagefind-body={indexable ? true : undefined}>
			<Hero content={post} />
			<div
				class="prose prose-sm prose-cactus mt-12 prose-headings:font-semibold prose-headings:before:absolute prose-headings:before:-ml-4 prose-headings:before:text-accent prose-headings:before:content-['#'] prose-th:before:content-none"
			>
				<slot />
			</div>
		</article>
		{
			(tags.length > 0 || headings.length > 0) && (
				<aside class="sm:sticky self-start top-8">
					<TagSidebar tags={tags} />
					{headings.length > 0 && (
						<div class:list={["hidden text-right sm:block", tags.length > 0 && "mt-8"]}>
							<h2 class="font-semibold">Table of Contents</h2>
							<ul class="mt-4 text-xs">
								{headings.map(({ slug, text, depth }) => {
									if (depth === minDepth) {
										return (
											<li class="mt-2 line-clamp-2 hover:text-accent">
												<a href={`#${slug}`} aria-label={`Scroll to section: ${text}`}>
													{text}
												</a>
											</li>
										);
									}
									if (depth - 1 === minDepth) {
										return (
											<li class="mt-0 text-gray-400 line-clamp-2 hover:text-accent">
												<a href={`#${slug}`} aria-label={`Scroll to section: ${text}`}>
													{text}
												</a>
											</li>
										);
									}
									return null;
								})}
							</ul>
						</div>
					)}
				</aside>
			)
		}
	</div>
</Base>
