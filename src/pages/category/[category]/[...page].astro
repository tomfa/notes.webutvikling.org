---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import EntryPreview from "@/components/blog/EntryPreview";
import Pagination from "@/components/Paginator";
import { getUniqueCategories, getPostCategory, sortMDByDate, isVisible } from "@/utils";
import type { Entry } from "@/utils/post";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const allPosts = await getCollection("post");
	const allLinks = await getCollection("link");
	const allEntriesByDate = sortMDByDate([...allPosts, ...allLinks].filter(isVisible));
	const uniqueCategories = getUniqueCategories(allEntriesByDate);

	return uniqueCategories.flatMap((category) => {
		const filterEntries = allEntriesByDate.filter((entry) => getPostCategory(entry) === category);
		return paginate(filterEntries, {
			params: { category },
			pageSize: 10,
		});
	});
}

interface Props {
	page: Page<Entry>;
}

const { page } = Astro.props;
const { category } = Astro.params;

const meta = {
	title: `Category: ${category}`,
	description: `View all posts with the category - ${category}`,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			url: page.url.prev,
			text: `← Previous posts`,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			url: page.url.next,
			text: `More posts →`,
		},
	}),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6 flex items-center">
		<a href="/category/" class="text-accent sm:hover:underline">Categories</a><span class="ml-2 mr-3">→</span>
		<span class="text-xl">#{category}</span>
	</h1>
	<section aria-label="Blog post list">
		<ul class="mb-12 space-y-8 text-left">
			{
				page.data.map((p) => (
					<li class="flex flex-wrap items-center gap-x-2">
						<EntryPreview post={p} as="h2" withDesc={false} />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
