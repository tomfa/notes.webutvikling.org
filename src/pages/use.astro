---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import EntryFeed from "@/components/blog/EntryFeed";
import { sortMDByDate, isVisible } from "@/utils";

const allLinks = await getCollection("link");
const entries = allLinks.filter((p) => isVisible(p) && p.data.type === "lib");
const entriesByDate = sortMDByDate(entries);
---

<PageLayout
	meta={{
		title: "Notes and Anecdotes",
		description: "Random notes and anecdotes from tech and startups.",
	}}
>
	<div>
		<p class="mb-4 text-lg">Tools and libraries I recommend checking out.</p>
	</div>
	<EntryFeed entries={entriesByDate} />
</PageLayout>
