---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import EntryFeed from "@/components/blog/EntryFeed";
import { sortMDByDate, isVisible } from "@/utils";

const allLinks = await getCollection("link");
const videos = allLinks.filter((l) => isVisible(l) && l.data.type === "video");
const videosByDate = sortMDByDate(videos);
---

<PageLayout
	meta={{
		title: "Notes and Anecdotes",
		description: "Random notes and anecdotes from tech and startups.",
	}}
>
	<div>
		<p class="mb-4 text-lg">Likable videos on the internet.</p>
	</div>
	<EntryFeed entries={videosByDate} />
</PageLayout>
