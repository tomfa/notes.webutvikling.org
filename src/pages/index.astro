---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import EntryFeed from "@/components/blog/EntryFeed";
import { sortMDByDate, isVisible, isNotesEntry } from "@/utils";

const allPosts = await getCollection("post");
const allLinks = await getCollection("link");
const entries = sortMDByDate([...allPosts, ...allLinks].filter(isVisible).filter(isNotesEntry));
---

<PageLayout
	meta={{
		title: "Notes and Anecdotes",
		description: "Random notes and anecdotes from tech and startups.",
	}}
>
	<div>
		<p class="mb-4 text-lg">Random notes and anecdotes from tech and startups.</p>
	</div>
	<EntryFeed entries={entries} />
</PageLayout>
